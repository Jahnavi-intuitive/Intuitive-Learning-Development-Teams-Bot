.DS_Store

# Contains real employee PII (names/emails) via pg_dump — restore it
# straight into a target database with psql, never commit it. See
# RENDER_DEPLOY.md's data-migration step.
scripts/db_dump/*.sql

# Local editor/tooling and ADK session artifacts — not part of the app.
.claude/scheduled_tasks.lock
agent/adk_agent/.adk/

# Per-call LLM API log (services/llm_call_log.py) — local-disk runtime
# data, wiped on every Render restart anyway (see that module's docstring).
backend/logs/
