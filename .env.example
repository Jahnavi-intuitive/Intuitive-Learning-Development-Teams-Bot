# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (used by docker-compose and by the backend) ---
POSTGRES_USER=lnd_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=lnd_certification
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lnd_app:change_me_locally@localhost:5432/lnd_certification

# --- Backend ---
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# --- Gemini (used by the backend for KB embeddings, and by the ADK agent) ---
# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Excel tracker sync ---
# Path to the local certification tracker workbook (one sheet per certification)
TRACKER_XLSX_PATH=./data/trackers/certification_tracker.xlsx

# --- Dev-only "signed-in user" seam ---
# In production this becomes the Entra ID token subject, verified server-side.
# For local dev, the test UI sends this as the X-Employee-Id header.
DEV_DEFAULT_EMPLOYEE_ID=

# --- Production auth (see backend/app/services/entra_auth.py) ---
# Leave AUTH_MODE unset/"header" for local dev (the X-Employee-Id stand-in
# above). Set to "entra" only once real values are filled in below — the
# backend refuses to start in "entra" mode with either of these empty.
AUTH_MODE=header
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
# Comma-separated service-account emails allowed to relay a tool call on
# an employee's behalf (in practice: just the agent Cloud Run service's
# own SA) — see services/entra_auth.py::validate_service_id_token.
TRUSTED_SERVICE_ACCOUNTS=

# --- Vertex AI (production Gemini access — leave both unset for the
# direct GEMINI_API_KEY path above, used locally) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Reminder sweep ---
# Set to false on every Cloud Run instance if Cloud Scheduler is driving
# the sweep instead (see routers/internal.py) — an in-process scheduler
# on a scale-to-zero/multi-instance service would double-fire or silently
# never run. SWEEP_TRIGGER_SECRET is the shared secret Cloud Scheduler
# sends as X-Sweep-Trigger-Secret; leave empty to keep that endpoint
# refusing all requests.
NOTIFICATION_SWEEP_ENABLED=true
SWEEP_TRIGGER_SECRET=
