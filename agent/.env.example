# Copy to .env in this same directory. Never commit .env.

# Direct Gemini API (AI Studio) key — leaving GOOGLE_CLOUD_PROJECT /
# GOOGLE_GENAI_USE_ENTERPRISE unset keeps ADK on the direct-API path
# rather than Vertex AI, per https://adk.dev/agents/models/google-gemini/.
GOOGLE_API_KEY=

# --- Production (Vertex AI instead of a direct API key) ---
# Set both to switch ADK itself to Vertex — no code change, per the same
# adk.dev doc above. On Cloud Run this authenticates via the service's own
# identity (Application Default Credentials), not a stored key.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_GENAI_USE_ENTERPRISE=true

# The FastAPI backend this agent calls as tools. In production this is
# the backend's Cloud Run URL — gcp_id_token.py automatically attaches a
# Google-signed service token to every call once this isn't localhost (see
# backend/app/services/entra_auth.py::validate_service_id_token, and add
# this agent's own Cloud Run service account to the backend's
# TRUSTED_SERVICE_ACCOUNTS for that token to actually be accepted).
BACKEND_URL=http://localhost:8000
